"""
End-to-end checks for the jest toolchain.
"""
type E2e {
  """
  The git repository to run tests against as an end-to-end smoke test.
  """
  repo: String! = "https://github.com/kpenfound/demo-react-app"

  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) {
      raise message
    }
    null
  }

  """
  Run a check, raising its failure. A check called through a dependency comes
  back as a Check that has not run.
  """
  let run(check: Check!): Void {
    # Check.error is not null for a passing check when read from Dang, so ask
    # pass first and read the message only on failure.
    if (check.pass == false) {
      raise check.error.message ?? "check failed"
    }
    null
  }

  """
  Run the jest toolchain against a real-world repository.

  This pulls the demo repo, exposes it as a Workspace, and runs its test
  files end-to-end.
  """
  testDemoApp: Void @check {
    let ws = git(repo).head.tree.asWorkspace

    jest.projects(ws).get(key: ".").testFiles(ws).test(ws)
  }

  """
  A single Jest project, used as the building block of the synthetic
  multi-project workspaces below. The git metadata and the demo's own
  dagger.json are dropped so a copy nested inside another copy is an ordinary
  subdirectory rather than a repository or a module.
  """
  let project: Directory! {
    git(repo).head.tree.filter(exclude: [".git", "dagger.json"])
  }

  """
  Two sibling projects under a root that holds no config of its own:

      a/jest.config.js
      b/jest.config.js
  """
  let siblings: Directory! {
    directory
      .withDirectory("a", project)
      .withDirectory("b", project)
  }

  """
  A root project with a project nested under each of two subdirectories:

      jest.config.js
      a/jest.config.js
      b/jest.config.js
  """
  let nested: Directory! {
    project
      .withDirectory("a", project)
      .withDirectory("b", project)
  }

  """
  A root project with a nested project under a subdirectory holding no config
  of its own:

      jest.config.js
      work/                  <- no config
      work/app/jest.config.js
  """
  let ancestor: Directory! {
    project.withDirectory("work/app", project)
  }

  """
  Project keys discovered from `cwd` inside a synthetic workspace built from
  `tree`.
  """
  let projects(tree: Directory!, cwd: String!): [String!]! {
    jest.projects(tree.asWorkspace(cwd: cwd)).keys
  }

  """
  Fail unless discovery returned exactly the wanted keys, in order.
  """
  let assertKeys(got: [String!]!, want: [String!]!, context: String!): Void {
    assert(
      got == want,
      context + ": got [" + got.join(", ") + "], want [" + want.join(", ") + "]",
    )
  }

  """
  From a root holding no config, discovery returns every project beneath it;
  entering one of them, or any directory inside it, scopes discovery to that
  project alone. Keys stay workspace-root-relative wherever the client stands.
  """
  siblingDiscoveryCheck: Void @check {
    assertKeys(projects(siblings, "."), ["a", "b"], "from the workspace root")
    assertKeys(projects(siblings, "a"), ["a"], "from a")
    assertKeys(projects(siblings, "b"), ["b"], "from b")
    assertKeys(projects(siblings, "a/src"), ["a"], "from a/src")
    assertKeys(projects(siblings, "b/src/components"), ["b"], "from b/src/components")

    null
  }

  """
  A root project does not leak into a nested project's view: the config in the
  cwd shadows the enclosing one, so entering `a`, or a directory inside it,
  yields `a` alone, and a directory inside the root project yields the root
  project.
  """
  nestedDiscoveryCheck: Void @check {
    assertKeys(projects(nested, "."), [".", "a", "b"], "from the workspace root")
    assertKeys(projects(nested, "a"), ["a"], "from a")
    assertKeys(projects(nested, "b"), ["b"], "from b")
    assertKeys(projects(nested, "a/src"), ["a"], "from a/src")
    assertKeys(projects(nested, "src"), ["."], "from src")

    null
  }

  """
  From a subdirectory holding no config, the nearest enclosing project is
  reported alongside the projects below the cwd, and its key resolves back to
  the enclosing project's source.
  """
  ancestorDiscoveryCheck: Void @check {
    let ws = ancestor.asWorkspace(cwd: "work")
    let found = jest.projects(ws)

    assertKeys(found.keys, [".", "work/app"], "from work")
    assert(
      found.get(key: ".").source(ws).glob("jest.config.js").length == 1,
      "the enclosing project's key did not resolve back to its source",
    )
    assert(
      found.get(key: "work/app").source(ws).glob("jest.config.js").length == 1,
      "the nested project's key did not resolve back to its source",
    )

    null
  }

  """
  Projects form a collection keyed by root: get builds the project at its key;
  subset keeps parent order, rejects unknown and duplicate keys, and narrows
  what get accepts; an empty subset is valid and runs nothing.
  """
  projectCollectionCheck: Void @check {
    let ws = nested.asWorkspace
    let found = jest.projects(ws)

    assert(found.get(key: "a").path == "a", "get did not return the project at its key")
    assert(
      found.list.{{path}}.map { p => p.path } == found.keys,
      "list did not return one project per key, in key order",
    )

    let pair = found.subset(keys: ["b", "a"])
    assertKeys(pair.keys, ["a", "b"], "subset order")

    let outside = { pair.get(key: ".").path } rescue {
      err: Error => "rejected"
    }
    assert(outside == "rejected", "get accepted a key outside the subset")

    let unknown = { found.subset(keys: ["no/such/project"]).keys.join(","); "accepted" } rescue {
      err: Error => "rejected"
    }
    assert(unknown == "rejected", "subset accepted an unknown key")

    let duplicate = { found.subset(keys: ["a", "a"]).keys.join(","); "accepted" } rescue {
      err: Error => "rejected"
    }
    assert(duplicate == "rejected", "subset accepted a duplicate key")

    let none = found.subset(keys: [])
    assert(none.keys.length == 0, "empty subset kept keys: " + none.keys.join(", "))
    none.test(ws)

    null
  }

  """
  Test files are found statically with Jest's default testMatch, keyed by
  project-relative path in byte order. node_modules, git-ignored files and
  nested projects are left out, and so are files that only look like tests.
  """
  testFileDiscoveryCheck: Void @check {
    let test = "test('passes', () => {})\n"
    let tree = directory
      .withNewFile("jest.config.js", "module.exports = {}\n")
      .withNewFile("src/a.test.js", test)
      .withNewFile("src/a.test.js.snap", test)
      .withNewFile("src/util.js", test)
      .withNewFile("src/testing.js", test)
      .withNewFile("src/latest.js", test)
      .withNewFile("__tests__/b.js", test)
      .withNewFile("__tests__/deep/c.tsx", test)
      .withNewFile("__tests__/notes.md", test)
      .withNewFile("test.js", test)
      .withNewFile("x.test.mjs", test)
      .withNewFile("y.spec.cts", test)
      .withNewFile("node_modules/dep/d.test.js", test)
      .withNewFile("lib/node_modules/dep/__tests__/e.js", test)
      .withNewFile("dist/f.test.js", test)
      .withNewFile("build/g.test.js", test)
      # A git checkout: ripgrep reads .gitignore only inside a repository.
      .withNewFile(".git/HEAD", "ref: refs/heads/main\n")
      .withNewFile(".gitignore", "ignored/\n")
      .withNewFile("ignored/j.test.js", test)
      .withNewFile("sub/jest.config.js", "module.exports = {}\n")
      .withNewFile("sub/h.spec.ts", test)
      .withNewFile("sub/__tests__/i.js", test)
    let ws = tree.asWorkspace
    let found = jest.projects(ws)

    assertKeys(found.keys, [".", "sub"], "projects")
    assertKeys(
      found.get(key: ".").testFiles(ws).keys,
      [
        "__tests__/b.js",
        "__tests__/deep/c.tsx",
        "build/g.test.js",
        "dist/f.test.js",
        "src/a.test.js",
        "test.js",
        "x.test.mjs",
        "y.spec.cts",
      ],
      "root test files",
    )
    assertKeys(
      found.get(key: "sub").testFiles(ws).keys,
      ["__tests__/i.js", "h.spec.ts"],
      "nested test files",
    )

    # Keys do not depend on where the client stands.
    let inside = tree.asWorkspace(cwd: "sub")
    assertKeys(
      jest.projects(inside).get(key: "sub").testFiles(inside).keys,
      ["__tests__/i.js", "h.spec.ts"],
      "nested test files from sub",
    )

    null
  }

  """
  A failing test file, used to observe which files a run actually covered.
  The demo's jest.config.js roots the run at `src`, so that is where it lands.
  """
  let failingTest: String! = "test('fails', () => { expect(1).toBe(2) })\n"

  """
  Whether running the projects visible from `cwd` observed the failure planted
  in `tree`.
  """
  let projectsFailed(tree: Directory!, cwd: String!): Boolean! {
    let ws = tree.asWorkspace(cwd: cwd)
    let observed = {
      jest.projects(ws).test(ws)
      false
    } rescue true
    observed
  }

  """
  Whether a check observed a failure.
  """
  let failed(check: Check!): Boolean! {
    {
      run(check)
      false
    } rescue true
  }

  """
  Whether running the selected test files observed a failure. The test file
  functions are plain functions, so they raise rather than return a Check.
  """
  let filesFailed(files: JestTestFiles!, ws: Workspace!): Boolean! {
    {
      files.test(ws)
      false
    } rescue true
  }

  """
  Whether running a whole test file observed a failure.
  """
  let fileFailed(file: JestTestFile!, ws: Workspace!): Boolean! {
    {
      file.test(ws)
      false
    } rescue true
  }

  """
  Running the projects runs every project below the cwd, and entering one of
  them leaves its siblings out of reach.
  """
  descendantScopeCheck: Void @check {
    let broken = siblings.withNewFile("b/src/broken.test.js", failingTest)

    if (projectsFailed(broken, ".") == false) {
      raise "running the projects from the workspace root should have run the project b"
    }
    if (projectsFailed(broken, "a")) {
      raise "running the projects from a should not have run the sibling project b"
    }
    if (projectsFailed(broken, "a/src")) {
      raise "running the projects from a/src should not have run the sibling project b"
    }
    if (projectsFailed(broken, "b/src") == false) {
      raise "running the projects from b/src should have run the enclosing project b"
    }
    if (projectsFailed(
      siblings.withNewFile("a/src/broken.test.js", failingTest),
      "a",
    ) == false) {
      raise "running the projects from a should have run a's own tests"
    }

    null
  }

  """
  A cwd holding no config sits inside its enclosing project, so running the
  projects from it runs that project too rather than only the ones below it.
  """
  ancestorScopeCheck: Void @check {
    if (projectsFailed(
      ancestor.withNewFile("src/broken.test.js", failingTest),
      "work",
    ) == false) {
      raise "running the projects from work should have run the enclosing project"
    }

    null
  }

  """
  A project's test files form a nested collection. Selecting only passing
  files runs just those, even beside a failing one; selecting the failing file
  fails; and with nothing selected out the project runs natively with its own
  config, which reaches tests static discovery leaves out (here, a nested
  project's), while a filtered run does not.
  """
  testFileRunCheck: Void @check {
    let tree = project
      .withNewFile("src/broken.test.js", failingTest)
    let ws = tree.asWorkspace
    let files = jest.projects(ws).get(key: ".").testFiles(ws)
    let pass = "src/App.test.jsx"
    let fail = "src/broken.test.js"

    assert(files.keys.contains(pass), "missing " + pass + " in " + files.keys.join(", "))
    assert(files.keys.contains(fail), "missing " + fail + " in " + files.keys.join(", "))
    assert(files.get(key: pass).path == pass, "get did not return the file at its key")

    files.subset(keys: [pass]).test(ws)
    files.get(key: pass).test(ws)
    assert(fileFailed(files.get(key: fail), ws), "the failing file passed on its own")
    assert(filesFailed(files.subset(keys: [pass, fail]), ws), "a subset with the failing file passed")
    assert(filesFailed(files, ws), "the whole run missed the failing file")
    files.subset(keys: []).test(ws)

    # A failing test in a nested project under src: static discovery gives it
    # to the nested project, but Jest's own run of the root project finds it.
    let hidden = project
      .withNewFile("src/inner/jest.config.js", "module.exports = {}\n")
      .withNewFile("src/inner/broken.test.js", failingTest)
      .asWorkspace
    let rootFiles = jest.projects(hidden).get(key: ".").testFiles(hidden)
    assert(
      rootFiles.keys.contains("src/inner/broken.test.js") == false,
      "a nested project's test file was keyed under the root project",
    )
    assert(filesFailed(rootFiles, hidden), "the whole run did not run the project natively")
    rootFiles.subset(keys: rootFiles.keys.dropLast(1)).test(hidden)

    null
  }

  """
  A test file's tests form a nested collection keyed by the name Jest calls
  them by, describes included. Selecting one runs it alone. A test the source
  does not name -- a .each row, a computed name -- is keyed "*" with the
  others like it, and a file that has only those is keyed with "*" alone. A
  test's check fails for its own failure; a failing unnamed test fails "*".
  """
  testRunCheck: Void @check {
    let named = "src/named.test.js"
    let computed = "src/computed.test.js"
    let ws = project
      .withNewFile(named, ```js
        describe('group', () => {
          test('passes', () => {})
          test('fails', () => { expect(1).toBe(2) })
        })
        test.each([1, 2])('each %s', (n) => { expect(n).toBe(3) })
      ``` + "\n")
      .withNewFile(computed, ```js
        const name = 'computed'
        test(name, () => { expect(1).toBe(2) })
      ``` + "\n")
      .asWorkspace
    let files = jest.projects(ws).get(key: ".").testFiles(ws)
    let tests = files.get(key: named).tests

    assertKeys(tests.keys, ["group passes", "group fails", "*"], "test names")
    assert(tests.get(key: "group fails").name == "group fails", "get did not return the test at its key")

    # The collection's test function is a plain function: it raises.
    tests.subset(keys: ["group passes"]).test(ws)
    assert(testsFailed(tests.subset(keys: ["group fails"]), ws), "the failing test passed on its own")
    assert(testsFailed(tests, ws), "the whole file run missed the failing each row")

    # Each test's check shares one run over the selection it is given.
    run(tests.get(key: "group passes").test(ws, selection: files))
    assert(failed(tests.get(key: "group fails").test(ws, selection: files)), "the failing test's check passed")
    assert(failed(tests.get(key: "*").test(ws, selection: files)), "the failing each row did not fail *")

    let only = files.get(key: computed).tests
    assertKeys(only.keys, ["*"], "a file whose test names are computed")
    assert(failed(only.get(key: "*").test(ws, selection: files)), "* did not run the whole file")

    null
  }

  """
  Whether running the selected tests of a file observed a failure.
  """
  let testsFailed(tests: JestTests!, ws: Workspace!): Boolean! {
    {
      tests.test(ws)
      false
    } rescue true
  }

  """
  Test names are read statically, as Jest joins them, and only where the
  source fixes them: a test declared inside a helper, a loop, a callback or a
  method gets its name from where it runs, and one under a condition -- if,
  else, try, catch, switch, a ternary, && -- may not run, so each is keyed
  "*", as are tests under a describe whose name is not a literal. A plain
  block is transparent.
  """
  testNameDiscoveryCheck: Void @check {
    let file = "src/names.test.js"
    let ws = project
      .withNewFile(file, ```js
        describe('outer', () => {
          describe('inner', function () {
            it('deep', () => {})
          })
          test('shallow', async () => {})
          const shared = () => { test('from helper', () => {}) }
          shared()
          for (const n of [1, 2]) {
            test('looped', () => {})
          }
          [1].forEach((n) => test('callback', () => {}))
          beforeEach(() => {})
        })
        function suite(name) {
          describe(name, () => { test('in suite', () => {}) })
        }
        suite('a')
        const n = 1
        describe('concatenated ' + n, () => { test('under concatenation', () => {}) })
        test('also ' + n, () => {})
        test(`plain template`, () => {})
        if (process.env.NEVER_SET) { test('in if', () => {}) } else { test('in else', () => {}) }
        if (process.env.NEVER_SET) test('braceless', () => {})
        try { test('in try', () => {}) } catch (e) { test('in catch', () => {}) }
        switch (process.env.NEVER_SET) { case 'a': test('in switch', () => {}) }
        process.env.NEVER_SET ? test('in ternary', () => {}) : null
        process.env.NEVER_SET && test('in and', () => {})
        class Suite { register() { test('in method', () => {}) } }
        { test('in block', () => {}) }
        test('last', () => {})
      ``` + "\n")
      .asWorkspace
    assertKeys(
      jest.projects(ws).get(key: ".").testFiles(ws).get(key: file).tests.keys,
      ["outer inner deep", "outer shallow", "plain template", "in block", "last", "*"],
      "static test names",
    )
    null
  }

  """
  Settings on the Jest object reach every run: flags are passed to jest, and
  build runs the package's build script first.
  """
  settingsCheck: Void @check {
    let file = "src/settings.test.js"
    let ws = project
      .withNewFile(file, ```js
        import fs from 'fs'
        test('selected', () => {})
        test('unselected', () => { expect(1).toBe(2) })
        test('built', () => { expect(fs.existsSync('build/index.html')).toBe(true) })
      ``` + "\n")
      .asWorkspace

    let planted(tool: Jest!): JestTestFile! {
      tool.projects(ws).get(key: ".").testFiles(ws).get(key: file)
    }

    assert(fileFailed(planted(jest), ws), "the planted file passed without flags")
    planted(jest(flags: ["--testNamePattern=^selected$"])).test(ws)
    planted(jest(build: true, flags: ["--testNamePattern=^built$"])).test(ws)
    assert(
      fileFailed(planted(jest(flags: ["--testNamePattern=^built$"])), ws),
      "the build output existed without build",
    )

    null
  }

  # Only the unindented CHECKS header counts: nested TESTS summaries count the
  # tests Jest reports, not the checks Dagger attributes them to. Without a
  # terminal the report drops the "==" around its headers.
  let checkSummaryMatches(output: String!, passed: Int!, failed: Int!): Boolean! {
    let headers = output.split("\n").filter { line =>
      line.hasPrefix("CHECKS ") or line.hasPrefix("== CHECKS ==")
    }
    let expected = (if (failed > 0) { ["✘", toString(failed), "failed"] } else { [] })
      + (if (passed > 0) { ["✔", toString(passed), "passed"] } else { [] })
    headers.length == 1 and headers[0]!.trimPrefix("== ").trimPrefix("CHECKS").trimPrefix(" ==")
      .trimSpace.split(" ").filter { word => word != "" } == expected
  }

  selectedSummaryCheck: Void @check {
    let wrong = "CHECKS  ✘ 8 failed\n  TESTS\n    ✘ 1 failed\n    ✔ 7 passed\n"
    assert(checkSummaryMatches(wrong, 7, 1) == false, "nested test counts hid failed checks")
    assert(checkSummaryMatches(wrong, 0, 8), "zero passing checks were not recognized")
    assert(checkSummaryMatches("CHECKS  ✔ 18 passed\n", 8, 0) == false, "accepted a partial count")
    assert(checkSummaryMatches("CHECKS  ✘ 1 failed  ✔ 7 passed\n", 7, 1), "mixed counts were not recognized")
    assert(checkSummaryMatches("  CHECKS  ✔ 8 passed\n", 8, 0) == false, "accepted a nested header")
    null
  }

  """
  Run the engine-provided CLI on a fixture workspace with the toolchain
  installed as jest, plus any extra dagger.toml text. Selection goes through
  the CLI because direct Dang calls do not apply the engine's filtered
  collection view.
  """
  let selectedRun(ws: Workspace!, fixture: Directory!, args: [String!]!, config: String! = ""): Container! {
    container
      .from("alpine:3.23")
      # The CLI searches its local workspace with the client's grep, and
      # busybox grep lacks the flags it passes.
      .withExec(["apk", "add", "--no-cache", "grep"])
      .withEnvVariable("NO_COLOR", "1")
      .withDirectory("/source", ws.directory("/", exclude: ["**/node_modules", "dist"]))
      .withDirectory("/work", fixture)
      .withNewFile("/work/.git/HEAD", "ref: refs/heads/main\n")
      .withNewFile("/work/dagger.toml", "[modules.jest]\nsource = \"/source\"\n" + config)
      .withWorkdir("/work")
      .withExec(
        ["/dev/.dagger/dagger", "--progress=report"] + args,
        expect: ReturnType.ANY,
        daggerInDaggerNewSession: true,
      )
  }

  """
  Run `dagger check` on a fixture and assert the check totals and messages.
  """
  let selectedCheck(
    ws: Workspace!,
    fixture: Directory!,
    args: [String!]!,
    passed: Int!,
    failed: Int! = 0,
    messages: [String!]! = [],
  ): Void {
    let result = selectedRun(ws, fixture, ["check", "--generated=false"] + args)
    let output = result.stdout + result.stderr
    assert((result.exitCode == 0) == (failed == 0), "unexpected check exit status:\n" + output)
    assert(checkSummaryMatches(output, passed, failed), "unexpected Dagger check totals:\n" + output)
    messages.map { message =>
      assert(output.contains(message), "missing " + message + ":\n" + output)
    }
    null
  }

  """
  Run selected checks and count the Jest runs the report shows: it nests a
  run's tests under the check that started it, one TESTS block per run.
  """
  let selectedRuns(ws: Workspace!, fixture: Directory!, args: [String!]!, passed: Int!, tests: String!): Int! {
    let result = selectedRun(ws, fixture, ["check", "--generated=false"] + args)
    let output = result.stdout + result.stderr
    assert(result.exitCode == 0, "the selected checks failed:\n" + output)
    assert(checkSummaryMatches(output, passed, 0), "unexpected Dagger check totals:\n" + output)
    let lines = output.split("\n").map { line => line.trimSpace }
    let runs = lines.filter { line => line == "TESTS" or line == "== TESTS ==" }.length
    let shared = lines.filter { line => line == tests }.length
    assert(runs == shared, "a run did not show " + tests + ":\n" + output)
    runs
  }

  """
  Three tests in each of two files in each of two projects, sharing one
  install. A test named other records that it ran, and each project's global
  teardown fails the run when it did, so a run that should have left it out
  fails every check of its project.
  """
  let selectionFixture: Directory! {
    let tests = "test('foo', () => {})\ntest('bar', () => {})\ntest('other', () => { require('fs').writeFileSync('/tmp/other-ran', '') })\n"
    let teardown = "module.exports = async () => {\n  if (require('fs').existsSync('/tmp/other-ran')) throw new Error('excluded test ran')\n}\n"
    ["p1", "p2"].reduce(
      directory.withNewFile(
        "package.json",
        "{\"name\": \"selection\", \"private\": true, \"devDependencies\": {\"jest\": \"30.2.0\"}}\n",
      ),
    ) { dir, project =>
      dir
        .withNewFile(project + "/jest.config.js", "module.exports = { globalTeardown: '<rootDir>/teardown.js' }\n")
        .withNewFile(project + "/teardown.js", teardown)
        .withNewFile(project + "/a.test.js", tests)
        .withNewFile(project + "/b.test.js", tests)
    }
  }

  let selectionArgs: [String!]! = ["--jest-test=foo", "--jest-test=bar"]

  """
  Selecting tests by name across two projects and two files each runs exactly
  those, one check per test, and leaves the unselected test out.
  """
  selectedTestsCheck(ws: Workspace!): Void @check {
    selectedCheck(ws, selectionFixture, selectionArgs, passed: 8)
  }

  """
  With several tests selected, each project runs Jest once: every check of a
  project builds the same command.
  """
  selectedSharedRunCheck(ws: Workspace!): Void @check {
    let runs = selectedRuns(ws, selectionFixture, selectionArgs, passed: 8, tests: "✔ 4 passed")
    assert(runs == 2, "expected one Jest run per project, saw " + toString(runs))
    null
  }

  """
  A single selected test runs alone, in one Jest run.
  """
  selectedSingleTestCheck(ws: Workspace!): Void @check {
    let args = ["--jest-project=p1", "--jest-test-file=a.test.js", "--jest-test=foo"]
    let runs = selectedRuns(ws, selectionFixture, args, passed: 1, tests: "✔ 1 passed")
    assert(runs == 1, "expected one Jest run, saw " + toString(runs))
    null
  }

  """
  A failing test fails its own check only.
  """
  selectedFailureCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile(
      "p1/a.test.js",
      "test('foo', () => { throw new Error('selected failure') })\ntest('bar', () => {})\n",
    )
    selectedCheck(
      ws,
      fixture,
      selectionArgs,
      passed: 7,
      failed: 1,
      messages: ["jest-project=p1&jest-test-file=a.test.js&jest-test=foo", "selected failure"],
    )
  }

  """
  A test file that fails to run fails the selected checks in it, and no other.
  """
  selectedFileFailureCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile(
      "p2/b.test.js",
      "test('foo', () => {})\ntest('bar', () => {})\nthis is not javascript\n",
    )
    selectedCheck(
      ws,
      fixture,
      selectionArgs,
      passed: 6,
      failed: 2,
      messages: ["Jest project p2, b.test.js: the test file failed outside its tests"],
    )
  }

  """
  A project whose config fails to load fails its own checks, naming the
  config; the other project's run is separate and passes.
  """
  selectedSetupFailureCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile("p2/jest.config.js", "throw new Error('config-error-marker')\n")
    selectedCheck(
      ws,
      fixture,
      selectionArgs,
      passed: 4,
      failed: 4,
      messages: ["jest failed (exit 1) without a report", "config-error-marker", "/src/p2/jest.config.js"],
    )
  }

  """
  A project whose config discovery cannot make sense of -- here, one that
  does not parse -- is still listed with Jest's defaults rather than failing
  the listing, and fails alone when it runs, naming the file; the other
  project is unaffected.
  """
  selectedDiscoveryFailureCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture.withNewFile("p2/jest.config.js", "module.exports = { testMatch: [\n")
    selectedCheck(
      ws,
      fixture,
      selectionArgs,
      passed: 4,
      failed: 4,
      messages: ["jest-project=p2", "/src/p2/jest.config.js"],
    )
  }

  """
  A project of one passing test file, for the reporting checks below.
  """
  let reportingFixture: Directory! {
    directory
      .withNewFile(
        "package.json",
        "{\"name\": \"reporting\", \"private\": true, \"devDependencies\": {\"jest\": \"30.2.0\"}}\n",
      )
      .withNewFile("r/jest.config.js", "module.exports = {}\n")
      .withNewFile("r/ok.test.js", "test('ok', () => {})\n")
  }

  """
  A failing .each row has no name in the source, so it fails the file's "*"
  check and no other.
  """
  selectedEachFailureCheck(ws: Workspace!): Void @check {
    let fixture = reportingFixture.withNewFile(
      "r/each.test.js",
      "test('named', () => {})\ntest.each([1])('row %s', () => { throw new Error('each failure') })\n",
    )
    selectedCheck(
      ws,
      fixture,
      ["--jest-project=r"],
      passed: 2,
      failed: 1,
      # The report shows the failing check and the test's diagnostics, but
      # hides the check's own error when it has failing test spans.
      messages: ["jest-test-file=each.test.js&jest-test=*", "each failure"],
    )
  }

  """
  A failing test the source declares nowhere it can see -- here, one a file it
  requires declares -- has no check of its own and no "*" to land on, so it
  fails every selected test of its file.
  """
  selectedUnnamedFailureCheck(ws: Workspace!): Void @check {
    let fixture = reportingFixture
      .withNewFile("r/shared.js", "module.exports = () => test('from shared', () => { throw new Error('shared failure') })\n")
      .withNewFile("r/uses.test.js", "test('named', () => {})\nrequire('./shared')()\n")
    selectedCheck(
      ws,
      fixture,
      ["--jest-project=r"],
      passed: 1,
      failed: 1,
      messages: ["jest-test-file=uses.test.js&jest-test=named", "shared failure"],
    )
  }

  """
  Tests declared in a helper get their names where the helper runs, so they
  are "*", not mis-keyed tests that never run; nested describes name their
  tests the way Jest does.
  """
  selectedNamesCheck(ws: Workspace!): Void @check {
    let fixture = reportingFixture.withNewFile(
      "r/names.test.js",
      "const shared = () => test('shared', () => {})\ndescribe('a', shared)\ndescribe('b', shared)\ndescribe('outer', () => {\n  describe('inner', () => {\n    test('deep', () => {})\n  })\n})\n",
    )
    selectedCheck(ws, fixture, ["--jest-project=r", "--jest-test-file=names.test.js"], passed: 2)
    selectedCheck(ws, fixture, ["--jest-project=r", "--jest-test=outer inner deep"], passed: 1)
    # "*" alone runs the tests no selected file names, and nothing else.
    selectedCheck(ws, fixture, ["--jest-project=r", "--jest-test=*"], passed: 1)
  }

  """
  A failing test file Jest's config finds but discovery does not -- here,
  through a testMatch that is not all literals -- has no check of its own, so
  it fails every check of its project's run.
  """
  selectedUncheckedFailureCheck(ws: Workspace!): Void @check {
    let fixture = reportingFixture
      .withNewFile(
        "r/jest.config.js",
        "const extra = '**/*.check.js'\nmodule.exports = { testMatch: ['**/*.test.js', extra] }\n",
      )
      .withNewFile("r/broken.check.js", "test('broken', () => { throw new Error('unchecked failure') })\n")
    selectedCheck(
      ws,
      fixture,
      ["--jest-project=r"],
      passed: 0,
      failed: 1,
      messages: ["jest-test-file=ok.test.js&jest-test=ok", "unchecked failure"],
    )
  }

  """
  A selected test Jest never runs fails, saying so, rather than passing:
  here, in a file discovery lists but Jest's config ignores, through a
  testPathIgnorePatterns that is not a literal.
  """
  selectedNeverRanCheck(ws: Workspace!): Void @check {
    let fixture = reportingFixture
      .withNewFile(
        "r/jest.config.js",
        "const ignore = ['/node_modules/', '/ghost/']\nmodule.exports = { testPathIgnorePatterns: ignore }\n",
      )
      .withNewFile("r/ghost/x.test.js", "test('ghost', () => {})\n")
    selectedCheck(
      ws,
      fixture,
      ["--jest-project=r"],
      passed: 1,
      failed: 1,
      messages: ["did not run: jest ran no tests from ghost/x.test.js"],
    )
  }

  """
  A test under a condition is "*", so it passes whether or not the condition
  holds, rather than failing as not run.
  """
  selectedConditionalCheck(ws: Workspace!): Void @check {
    let fixture = reportingFixture.withNewFile(
      "r/cond.test.js",
      "test('always', () => {})\nif (process.env.NEVER_SET) {\n  test('sometimes', () => {})\n}\n",
    )
    selectedCheck(ws, fixture, ["--jest-project=r"], passed: 3)
  }

  """
  Jest scopes .only to its file and skips the file's other tests, and skip,
  x-prefixed and todo tests are pending: all of them appear in the report,
  so their checks pass rather than fail as not run. The unfocused test would
  fail if it ran.
  """
  selectedOnlyCheck(ws: Workspace!): Void @check {
    let fixture = reportingFixture.withNewFile(
      "r/only.test.js",
      "test.only('focused', () => {})\ntest('unfocused', () => { throw new Error('ran despite only') })\ntest.skip('skipped', () => {})\nxit('crossed', () => {})\ntest.todo('later')\n",
    )
    selectedCheck(ws, fixture, ["--jest-project=r"], passed: 6)
  }

  """
  Listing runs no tool: with a base image that does not exist, an install
  that fails and a config that throws, `dagger check -l` still lists every
  test, while running the checks fails.
  """
  listingRunsNothingCheck(ws: Workspace!): Void @check {
    let fixture = selectionFixture
      .withNewFile(
        "package.json",
        "{\"name\": \"broken\", \"private\": true, \"scripts\": {\"postinstall\": \"exit 3\"}, \"devDependencies\": {\"jest\": \"30.2.0\"}}\n",
      )
      .withNewFile("p2/jest.config.js", "throw new Error('config-error-marker')\n")
    let config = "[modules.jest.settings]\nbaseImageAddress = \"registry.invalid/no-such-image:0\"\n"
    let listed = selectedRun(ws, fixture, ["check", "-l", "--all"], config: config)
    let output = listed.stdout + listed.stderr
    assert(listed.exitCode == 0, "listing failed:\n" + output)
    let rows = output.split("\n").filter { line => line.contains("test.js") }
    assert(rows.length == 12, "expected twelve tests listed:\n" + output)
    let ran = selectedRun(ws, fixture, ["check", "--generated=false"] + selectionArgs, config: config)
    assert(ran.exitCode != 0, "the broken base image was never used:\n" + ran.stdout + ran.stderr)
    null
  }

  """
  A project with Jest installed, for the checks below that run Jest on
  synthetic projects. They share one package.json, so they share one install.
  """
  let fixture(files: Directory!): Directory! {
    directory
      .withNewFile(
        "package.json",
        "{\"name\": \"fixture\", \"private\": true, \"devDependencies\": {\"jest\": \"30.2.0\"}}\n",
      )
      .withNewFile("jest.config.js", "module.exports = {}\n")
      .withDirectory(".", files)
  }

  """
  Why a project's whole run failed, or "passed".
  """
  let outcome(tree: Directory!, tool: Jest!): String! {
    let ws = tree.asWorkspace
    let result = {
      tool.projects(ws).test(ws)
      "passed"
    } rescue {
      err: Error => err.message
    }
    result
  }

  """
  A test that takes Jest's done callback runs under the Dagger hook: the hook
  keeps the test function's arity, so Jest still passes done.
  """
  doneCallbackCheck: Void @check {
    let tree = fixture(
      directory.withNewFile(
        "done.test.js",
        "test('calls done', (done) => { setTimeout(() => { expect(1).toBe(1); done() }, 10) })\n",
      ),
    )
    let result = outcome(tree, jest)
    assert(result == "passed", "a done-callback test failed under the hook: " + result)
    null
  }

  """
  Every span is exported and ended, whether Jest runs files in worker
  processes or in band: each file flushes its spans when it finishes, and a
  skipped or todo test's span ends too, and a test that deletes web globals
  such as ReadableStream doesn't break the export. The fixture's globalSetup points the
  exporter at a local collector that decodes what arrives, and its
  globalTeardown fails the run unless every expected span arrived ended.
  """
  spanExportCheck: Void @check {
    let collector = ```js
      const http = require("http");
      const root = require("/opt/dagger-jest/node_modules/@opentelemetry/otlp-transformer/build/src/generated/root.js");
      const Request = root.opentelemetry.proto.collector.trace.v1.ExportTraceServiceRequest;
      module.exports.setup = async () => {
        const spans = {};
        const server = http.createServer((req, res) => {
          const chunks = [];
          req.on("data", (c) => chunks.push(c));
          req.on("end", () => {
            const request = Request.decode(Buffer.concat(chunks));
            for (const rs of request.resourceSpans) {
              for (const ss of rs.scopeSpans) {
                for (const span of ss.spans) {
                  const ended = String(span.endTimeUnixNano) !== "0";
                  spans[span.name] = spans[span.name] || ended;
                }
              }
            }
            res.writeHead(200, { "content-type": "application/x-protobuf" });
            res.end();
          });
        });
        await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
        process.env.OTEL_EXPORTER_OTLP_TRACES_ENDPOINT = "http://127.0.0.1:" + server.address().port + "/v1/traces";
        globalThis.__collector = { server, spans };
      };
      module.exports.teardown = async () => {
        const { server, spans } = globalThis.__collector;
        server.close();
        const expected = ["alpha", "bravo", "charlie", "delta"]
          .flatMap((name) => [name + ".test.js", "span-marker-" + name])
          .concat(["slow.test.js", "slow-describe", "slow-test", "skipped-test", "todo-test", "globals-test"]);
        const missing = expected.filter((name) => spans[name] !== true);
        if (missing.length > 0) {
          throw new Error("spans not exported ended: " + missing.join(", "));
        }
      };
    ``` + "\n"
    let files = ["alpha", "bravo", "charlie", "delta"].reduce(
      directory
        .withNewFile("collector.js", collector)
        .withNewFile("setup.js", "module.exports = require('./collector').setup\n")
        .withNewFile("teardown.js", "module.exports = require('./collector').teardown\n")
        .withNewFile(
          "slow.test.js",
          "describe('slow-describe', () => {\n  test('slow-test', () => new Promise((resolve) => setTimeout(resolve, 500)))\n  test.skip('skipped-test', () => {})\n  test.todo('todo-test')\n})\n",
        )
        # A test that removes web globals from its own global object must not
        # break the exporter, which runs outside the test's realm.
        .withNewFile(
          "globals.test.js",
          "test('globals-test', async () => {\n  delete global.ReadableStream\n  delete global.fetch\n  delete global.TextEncoder\n  await new Promise((resolve) => setTimeout(resolve, 300))\n})\n",
        ),
    ) { dir, name =>
      dir.withNewFile(name + ".test.js", "test('span-marker-" + name + "', () => {})\n")
    }
    let config(workers: Int!): String! {
      "module.exports = { globalSetup: './setup.js', globalTeardown: './teardown.js', maxWorkers: "
        + toString(workers) + " }\n"
    }
    let workers = outcome(
      fixture(files).withNewFile("jest.config.js", config(2)),
      jest,
    )
    assert(workers == "passed", "spans were lost with worker processes: " + workers)
    let inBand = outcome(
      fixture(files).withNewFile("jest.config.js", config(1)),
      jest,
    )
    assert(inBand == "passed", "spans were lost in band: " + inBand)
    null
  }

  """
  A config that fails to load fails the run with Jest's own error in the
  message, hook or no hook.
  """
  configErrorCheck: Void @check {
    let tree = fixture(
      directory
        .withNewFile("jest.config.js", "throw new Error('config-error-marker')\n")
        .withNewFile("a.test.js", "test('a', () => {})\n"),
    )
    let result = outcome(tree, jest)
    assert(result.contains("jest failed"), "the failing step was not named: " + result)
    assert(result.contains("config-error-marker"), "the config error was swallowed: " + result)
    let withEnv = outcome(tree, jest(useEnv: true))
    assert(withEnv.contains("config-error-marker"), "the config error was swallowed with useEnv: " + withEnv)
    null
  }

  """
  Install behaviour: a failing install names its step and command,
  installFlags reach the install, environment reaches the tests, and a
  project without Jest installed says so instead of fetching it.
  """
  installCheck: Void @check {
    let scripted = directory
      .withNewFile(
        "package.json",
        "{\"name\": \"scripted\", \"private\": true, \"scripts\": {\"postinstall\": \"exit 3\"}, \"devDependencies\": {\"jest\": \"30.2.0\"}}\n",
      )
      .withNewFile("jest.config.js", "module.exports = {}\n")
      .withNewFile("env.test.js", "test('env', () => { expect(process.env.FIXTURE_VALUE).toBe('a=b') })\n")
    let failedInstall = outcome(scripted, jest)
    assert(
      failedInstall.contains("install failed (npm install, exit"),
      "the failing install was not named: " + failedInstall,
    )
    let fixed = outcome(scripted, jest(installFlags: ["--ignore-scripts"], environment: ["FIXTURE_VALUE=a=b"]))
    assert(fixed == "passed", "installFlags or environment did not apply: " + fixed)

    let missing = directory
      .withNewFile("package.json", "{\"name\": \"bare\", \"private\": true}\n")
      .withNewFile("jest.config.js", "module.exports = {}\n")
      .withNewFile("a.test.js", "test('a', () => {})\n")
    let notInstalled = outcome(missing, jest)
    assert(notInstalled.contains("jest is not installed"), "a missing jest was not reported: " + notInstalled)
    null
  }

  """
  A monorepo whose root config lists its packages in `projects`, with
  package configs that load a shared file from the root: the root project
  runs them, so the packages are not keyed again, and each package's files
  are keyed under the root and filtered by that package's literal config.
  Entering a package runs it on its own, with the whole workspace mounted.
  """
  monorepoCheck: Void @check {
    let test = "test('passes', () => {})\n"
    let tree = directory
      .withNewFile(
        "package.json",
        "{\"name\": \"mono\", \"private\": true, \"workspaces\": [\"packages/a\", \"packages/b\"], \"devDependencies\": {\"jest\": \"30.2.0\"}}\n",
      )
      .withNewFile("jest.base.config.js", "module.exports = (dir) => ({ rootDir: dir })\n")
      .withNewFile(
        "jest.config.js",
        "module.exports = {\n  projects: ['<rootDir>/packages/*/jest.config.js', '<rootDir>/packages/*/jest.config-*.js'],\n}\n",
      )
      .withNewFile("packages/a/package.json", "{\"name\": \"a\", \"version\": \"1.0.0\"}\n")
      .withNewFile(
        "packages/a/jest.config.js",
        "module.exports = { ...require('../../jest.base.config')(__dirname), testRegex: '__tests__/base/.*\\\\.js$' }\n",
      )
      .withNewFile("packages/a/__tests__/base/one.js", test)
      .withNewFile("packages/a/__tests__/utils/helper.js", "module.exports = {}\n")
      .withNewFile("packages/b/package.json", "{\"name\": \"b\", \"version\": \"1.0.0\"}\n")
      .withNewFile(
        "packages/b/jest.config-node.js",
        "module.exports = { rootDir: __dirname, testPathIgnorePatterns: ['/node_modules/', '/slow/'] }\n",
      )
      .withNewFile("packages/b/two.test.js", test)
      .withNewFile("packages/b/slow/three.test.js", failingTest)
      .withNewFile("docs/vendor/test.js", failingTest)
    let ws = tree.asWorkspace
    let found = jest.projects(ws)
    assertKeys(found.keys, ["."], "projects")
    let files = found.get(key: ".").testFiles(ws)
    assertKeys(
      files.keys,
      ["packages/a/__tests__/base/one.js", "packages/b/two.test.js"],
      "monorepo test files",
    )
    files.test(ws)
    files.subset(keys: ["packages/b/two.test.js"]).test(ws)

    let inA = tree.asWorkspace(cwd: "packages/a/__tests__")
    let own = jest.projects(inA)
    assertKeys(own.keys, ["packages/a"], "projects from inside packages/a")
    assertKeys(
      own.get(key: "packages/a").testFiles(inA).keys,
      ["__tests__/base/one.js"],
      "packages/a test files",
    )
    own.get(key: "packages/a").testFiles(inA).test(inA)
    null
  }

  """
  A file: dependency is installed from its own files, not just its
  package.json: the install copies or links it, so its whole directory is an
  install input.
  """
  localDependencyCheck: Void @check {
    let tree = directory
      .withNewFile(
        "package.json",
        "{\"name\": \"local\", \"private\": true, \"devDependencies\": {\"jest\": \"30.2.0\", \"local-dep\": \"file:./local-dep\"}}\n",
      )
      .withNewFile("local-dep/package.json", "{\"name\": \"local-dep\", \"version\": \"1.0.0\", \"main\": \"index.js\"}\n")
      .withNewFile("local-dep/index.js", "module.exports = { answer: 42 }\n")
      .withNewFile("jest.config.js", "module.exports = {}\n")
      .withNewFile("local.test.js", "test('local', () => { expect(require('local-dep').answer).toBe(42) })\n")
    let result = outcome(tree, jest)
    assert(result == "passed", "a file: dependency was not installed: " + result)
    null
  }

  """
  A workspace package's bin is linked into node_modules/.bin: the file it
  names is an install input, so pnpm can link it before the source is laid
  over the install.
  """
  workspaceBinCheck: Void @check {
    let tree = directory
      .withNewFile(
        "package.json",
        "{\"name\": \"binws\", \"private\": true, \"packageManager\": \"pnpm@9.15.0\", \"devDependencies\": {\"jest\": \"30.2.0\", \"fixture-cli\": \"workspace:*\"}}\n",
      )
      .withNewFile("pnpm-workspace.yaml", "packages:\n  - 'packages/*'\n")
      .withNewFile(
        "packages/cli/package.json",
        "{\"name\": \"fixture-cli\", \"version\": \"1.0.0\", \"bin\": {\"fixture-cli\": \"bin/cli.js\"}}\n",
      )
      # 493 is 0755.
      .withNewFile(
        "packages/cli/bin/cli.js",
        "#!/usr/bin/env node\nconsole.log('cli-ok')\n",
        permissions: 493,
      )
      .withNewFile("jest.config.js", "module.exports = { testPathIgnorePatterns: ['/node_modules/', '/packages/'] }\n")
      .withNewFile(
        "cli.test.js",
        "const { execFileSync } = require('child_process')\nconst path = require('path')\ntest('cli', () => {\n  expect(execFileSync(path.join(__dirname, 'node_modules/.bin/fixture-cli')).toString()).toContain('cli-ok')\n})\n",
      )
    # No lockfile in the fixture, so let pnpm write one.
    let result = outcome(tree, jest(installFlags: ["--no-frozen-lockfile"]))
    assert(result == "passed", "a workspace package's bin was not linked: " + result)
    null
  }

  """
  With build set, a package without a build script has nothing to build and
  still runs its tests, while a failing build script names the build step.
  """
  buildScriptCheck: Void @check {
    let test = fixture(
      directory.withNewFile("a.test.js", "test('a', () => {})\n"),
    )
    let noScript = outcome(test, jest(build: true))
    assert(noScript == "passed", "a package without a build script failed to build: " + noScript)
    let failing = test.withNewFile(
      "package.json",
      "{\"name\": \"fixture\", \"private\": true, \"scripts\": {\"build\": \"exit 4\"}, \"devDependencies\": {\"jest\": \"30.2.0\"}}\n",
    )
    let broken = outcome(failing, jest(build: true))
    assert(broken.contains("build failed (npm run build, exit 4)"), "a failing build was not named: " + broken)
    null
  }
}
